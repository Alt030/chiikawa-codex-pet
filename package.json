{
  "name": "chiikawa-codex-pet",
  "version": "0.1.8",
  "description": "Windows Codex companion with Shisa and Kurimanju",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm test && electron-builder --dir",
    "build:unpack": "electron-builder --dir",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --universal --publish never",
    "release:version": "npm version patch --no-git-tag-version",
    "test": "node --test",
    "hooks:doctor": "node src/hook-installer.js doctor",
    "hooks:preview": "node src/hook-installer.js preview",
    "hooks:install": "node src/hook-installer.js install",
    "hooks:uninstall": "node src/hook-installer.js uninstall"
  },
  "keywords": [
    "desktop-pet",
    "agent-hooks",
    "electron"
  ],
  "author": "Alt030",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alt030/chiikawa-codex-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Alt030/chiikawa-codex-pet/issues"
  },
  "homepage": "https://github.com/Alt030/chiikawa-codex-pet",
  "license": "MIT",
  "devDependencies": {
    "electron": "28.2.9",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
